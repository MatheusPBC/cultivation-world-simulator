msgid "MAP_REGION_CLASSIC_101_NAME"
msgstr "Đồng bằng Đông Nam"
msgid "MAP_REGION_CLASSIC_101_DESC"
msgstr "Vùng trung tâm bằng phẳng và ôn hòa nhất miền Đông Nam Cửu Châu, nơi ruộng tốt, kênh rạch và gió biển cùng trải rộng thành một miền khoáng đạt."
msgid "MAP_REGION_CLASSIC_102_NAME"
msgstr "Lưu Sa Tây Thùy"
msgid "MAP_REGION_CLASSIC_102_DESC"
msgstr "Miền biên viễn phía tây, nơi hoang mạc gặp gió biển giữa cồn cát vàng, bãi muối và đá vụn."
msgid "MAP_REGION_CLASSIC_104_NAME"
msgstr "Sương Nguyên Bắc Cảnh"
msgid "MAP_REGION_CLASSIC_104_DESC"
msgstr "Đồng hoang băng giá kéo dài từ vùng cao lạnh giá vào sâu trong nội địa, quanh năm bị cuồng phong rét buốt quét qua."
msgid "MAP_REGION_CLASSIC_105_NAME"
msgstr "Viễn Triều Đông Hải"
msgid "MAP_REGION_CLASSIC_105_DESC"
msgstr "Miền biển đông mênh mông, nơi thủy triều và các tuyến hải hành đan xen giữa trùng khơi."
msgid "MAP_REGION_CLASSIC_106_NAME"
msgstr "Cửa Vịnh Thiên Hà"
msgid "MAP_REGION_CLASSIC_106_DESC"
msgstr "Vùng nước êm nơi sông hòa vào biển, dòng chảy hiền hòa nên thuyền bè thường xuyên qua lại."
msgid "MAP_REGION_CLASSIC_107_NAME"
msgstr "Dãy Đông Lĩnh"
msgid "MAP_REGION_CLASSIC_107_DESC"
msgstr "Dãy núi dài ở phương đông, sống núi nhấp nhô tựa đường ranh chia cách non cao với biển cả."
msgid "MAP_REGION_CLASSIC_109_NAME"
msgstr "Thảo Nguyên Trung Châu"
msgid "MAP_REGION_CLASSIC_109_DESC"
msgstr "Thảo nguyên mênh mang đan xen đồi thấp, rất thích hợp để phàm nhân và các tông môn tu hành cùng sinh sống."
msgid "MAP_REGION_CLASSIC_110_NAME"
msgstr "Lâm Hải Thanh Vân"
msgid "MAP_REGION_CLASSIC_110_DESC"
msgstr "Rừng cây vô tận trải như biển mây, mỗi khi gió lướt qua lại dâng lên từng lớp sóng xanh."
msgid "MAP_REGION_CLASSIC_302_NAME"
msgstr "Biên Thành Nam Cương"
msgid "MAP_REGION_CLASSIC_302_DESC"
msgstr "Thành buôn nằm bên rìa rừng mưa Nam Cương, nơi dược liệu, xương yêu thú và lữ khách phương xa cùng hội tụ."
msgid "MAP_REGION_CLASSIC_403_NAME"
msgstr "Tĩnh Hải Nhai Nam Lĩnh"
msgid "MAP_REGION_CLASSIC_403_DESC"
msgstr "Một tông môn tọa lạc trên vách biển, điện các nửa ẩn trong tiếng sóng khi sương khơi men theo sườn núi dâng lên."
msgid "MAP_REGION_CLASSIC_409_NAME"
msgstr "Phù Không Đảo Đông Lĩnh"
msgid "MAP_REGION_CLASSIC_409_DESC"
msgstr "Quần đảo lơ lửng trên dãy Đông Lĩnh, những tầng đài cao nối liền bằng cầu mây và phi chu."

msgid "MAP_REGION_ISLAND_SEAS_101_NAME"
msgstr "Cô Châu Trung Hải"
msgid "MAP_REGION_ISLAND_SEAS_101_DESC"
msgstr "Một hòn đảo cỡ vừa trôi giữa biển xanh thẳm mênh mông."
msgid "MAP_REGION_ISLAND_SEAS_102_NAME"
msgstr "Sa Đảo Bắc Hải"
msgid "MAP_REGION_ISLAND_SEAS_102_DESC"
msgstr "Hòn đảo cát giữa vùng biển cạn phía bắc, nơi bãi đá ngầm và đụn cát vàng nâu gặp bờ biển luôn đổi hình theo sóng."
msgid "MAP_REGION_ISLAND_SEAS_105_NAME"
msgstr "Vô Ngân Hải Quốc"
msgid "MAP_REGION_ISLAND_SEAS_105_DESC"
msgstr "Nơi đây biển cả chính là đất liền, còn hải lộ và dòng triều là những con đường duy nhất."
msgid "MAP_REGION_ISLAND_SEAS_106_NAME"
msgstr "Hải Lộ Thủy Triều"
msgid "MAP_REGION_ISLAND_SEAS_106_DESC"
msgstr "Luồng nước thông thuyền men theo ranh giới biển sâu và biển cạn, tạo thành con đường tự nhiên giữa các đảo."
msgid "MAP_REGION_ISLAND_SEAS_118_NAME"
msgstr "Ngoại Đảo Bồng Lai"
msgid "MAP_REGION_ISLAND_SEAS_118_DESC"
msgstr "Hòn đảo cô độc cách xa quần đảo chính, tựa một mảnh ngọc vỡ rơi giữa biển khơi."
msgid "MAP_REGION_ISLAND_SEAS_103_NAME"
msgstr "Vũ Đảo Phía Tây"
msgid "MAP_REGION_ISLAND_SEAS_103_DESC"
msgstr "Hòn đảo phía tây nóng ẩm, nơi rừng mưa ôm sát bờ và dây leo cổ thụ khuất sâu trong sương biển."
msgid "MAP_REGION_ISLAND_SEAS_104_NAME"
msgstr "Băng Đảo Bắc Hàn"
msgid "MAP_REGION_ISLAND_SEAS_104_DESC"
msgstr "Hòn đảo bị hàn lưu phương bắc vây quanh, gió biển cuốn tuyết vụn qua bờ băng và đồng nguyên giá lạnh."
msgid "MAP_REGION_ISLAND_SEAS_107_NAME"
msgstr "Nham Đảo Đông Hải"
msgid "MAP_REGION_ISLAND_SEAS_107_DESC"
msgstr "Hòn đảo đá nhô lên giữa biển đông, với vách dựng, bãi ngầm và sống núi chen sát vào nhau."
msgid "MAP_REGION_ISLAND_SEAS_108_NAME"
msgstr "Tuyết Đảo Hàn Triều"
msgid "MAP_REGION_ISLAND_SEAS_108_DESC"
msgstr "Hòn đảo tuyết phong do hàn lưu phương bắc bồi thành, vách băng ánh lên sắc biển, từ xa tựa một dải núi trắng nổi giữa khơi."
msgid "MAP_REGION_ISLAND_SEAS_109_NAME"
msgstr "Lục Châu Trung Hải"
msgid "MAP_REGION_ISLAND_SEAS_109_DESC"
msgstr "Hòn đảo xanh tươi, khí hậu ôn hòa gần trung tâm quần đảo, cũng là một trong số ít bến đỗ rộng rãi và dễ cập vào."
msgid "MAP_REGION_ISLAND_SEAS_110_NAME"
msgstr "Nội Loan Thanh Mộc"
msgid "MAP_REGION_ISLAND_SEAS_110_DESC"
msgstr "Đảo rừng được vịnh biển ôm trọn, nơi bóng cây và gió biển ẩm tụ thành nguồn mộc linh khí dồi dào."
msgid "MAP_REGION_ISLAND_SEAS_111_NAME"
msgstr "Hỏa Đảo Xích Tiêu"
msgid "MAP_REGION_ISLAND_SEAS_111_DESC"
msgstr "Hòn đảo núi lửa trong chuỗi đảo phía tây, nơi đá ngầm đỏ rực vươn ra biển và hơi nóng thường phụt lên từ các khe nứt."
msgid "MAP_REGION_ISLAND_SEAS_112_NAME"
msgstr "Hải Điền Châu"
msgid "MAP_REGION_ISLAND_SEAS_112_DESC"
msgstr "Miền đất bằng phì nhiêu hiếm có giữa quần đảo trung tâm, nơi nước ngọt và gió biển cùng nuôi dưỡng những cánh đồng rộng lớn."
msgid "MAP_REGION_ISLAND_SEAS_113_NAME"
msgstr "Độc Loan Ám Triều"
msgid "MAP_REGION_ISLAND_SEAS_113_DESC"
msgstr "Vịnh đầm độc ở rìa chuỗi đảo tây nam, đặc quánh nước thối, dòng ngầm, hơi nóng và chướng khí."
msgid "MAP_REGION_ISLAND_SEAS_114_NAME"
msgstr "Quần Sơn Nam Tiêu"
msgid "MAP_REGION_ISLAND_SEAS_114_DESC"
msgstr "Dải núi đá ngầm hiểm trở giữa các đảo phương nam, nơi mọi đường bộ ngắn ngủi đều bị eo biển chia cắt."
msgid "MAP_REGION_ISLAND_SEAS_115_NAME"
msgstr "Quần Châu Trúc Ảnh"
msgid "MAP_REGION_ISLAND_SEAS_115_DESC"
msgstr "Những cù lao nhỏ phủ trúc rải rác trên vùng biển trung nam, tiếng lá xào xạc thường chìm khuất dưới âm vang thủy triều."
msgid "MAP_REGION_ISLAND_SEAS_116_NAME"
msgstr "Hoang Đảo Bắc Vụ"
msgid "MAP_REGION_ISLAND_SEAS_116_DESC"
msgstr "Hòn đảo hoang lạnh ở phương bắc, nơi sương biển và đất đóng băng khiến vạn vật chìm trong tĩnh lặng."
msgid "MAP_REGION_ISLAND_SEAS_117_NAME"
msgstr "Lệ Châu Tây Hải"
msgid "MAP_REGION_ISLAND_SEAS_117_DESC"
msgstr "Cù lao sỏi đá cạnh bãi cát tây bắc, bờ biển phủ kín đá phong hóa và lớp muối kết vảy."
msgid "MAP_REGION_ISLAND_SEAS_201_NAME"
msgstr "Kim Phủ Đông Hải"
msgid "MAP_REGION_ISLAND_SEAS_201_DESC"
msgstr "Động phủ hệ kim nằm sâu trong nham đảo Đông Hải, nơi gió biển luồn vào hang rồi hóa thành tiếng kiếm ngân trong trẻo."
msgid "MAP_REGION_ISLAND_SEAS_202_NAME"
msgstr "Động Thiên Thanh Mộc Loan"
msgid "MAP_REGION_ISLAND_SEAS_202_DESC"
msgstr "Động thiên hệ mộc trong vịnh Thanh Mộc, hội tụ khí ẩm của rừng già và sinh cơ từ biển cả."
msgid "MAP_REGION_ISLAND_SEAS_203_NAME"
msgstr "Huyền Thủy Cảnh Bắc Hải"
msgid "MAP_REGION_ISLAND_SEAS_203_DESC"
msgstr "Bí cảnh hệ thủy nằm sâu trong Bắc Hải, được dòng ngầm vây quanh, trong hang đá ngầm thường le lói ánh ngọc bích."
msgid "MAP_REGION_ISLAND_SEAS_205_NAME"
msgstr "Huyền Cung Hàn Triều"
msgid "MAP_REGION_ISLAND_SEAS_205_DESC"
msgstr "Huyền cung hệ thổ trong tuyết đảo, nơi băng và nền đá cộng hưởng qua những vách động nhẵn mịn như ngọc."
msgid "MAP_REGION_ISLAND_SEAS_301_NAME"
msgstr "Trung Hải Thành"
msgid "MAP_REGION_ISLAND_SEAS_301_DESC"
msgstr "Hải cảng trung tâm của quần đảo, nơi xưởng thuyền, chợ cầu và bến nổi xếp thành từng tầng."
msgid "MAP_REGION_ISLAND_SEAS_302_NAME"
msgstr "Hải Điền Thành"
msgid "MAP_REGION_ISLAND_SEAS_302_DESC"
msgstr "Thành nông thương trên Hải Điền Châu, nơi giếng nước ngọt nằm cạnh kho muối và chợ lương thực."
msgid "MAP_REGION_ISLAND_SEAS_303_NAME"
msgstr "Sa Tiêu Thành"
msgid "MAP_REGION_ISLAND_SEAS_303_DESC"
msgstr "Tòa thành ven đá ngầm trên Sa Đảo Bắc Hải, người ta đến đây theo thủy triều và buồm thuyền thay vì bằng thương đội vượt sa mạc."
msgid "MAP_REGION_ISLAND_SEAS_304_NAME"
msgstr "Hàn Loan Thành"
msgid "MAP_REGION_ISLAND_SEAS_304_DESC"
msgstr "Tòa thành tránh gió trên Băng Đảo Bắc Hàn, nơi cảng kín và phố lát đá ấm chào đón các tu sĩ thủy hệ."
msgid "MAP_REGION_ISLAND_SEAS_305_NAME"
msgstr "Cảng Lãm Nguyệt"
msgid "MAP_REGION_ISLAND_SEAS_305_DESC"
msgstr "Bến cảng ngập ánh trăng trên ngoại đảo đông nam, được các tu sĩ viễn du ưa chuộng làm nơi neo thuyền ngắm thủy triều."
msgid "MAP_REGION_ISLAND_SEAS_401_NAME"
msgstr "Tuyệt Vân Nham"
msgid "MAP_REGION_ISLAND_SEAS_401_DESC"
msgstr "Tông môn dựng trên vách đá của nham đảo phía đông, những cây cầu mây treo lơ lửng trên sóng dữ cuộn trào."
msgid "MAP_REGION_ISLAND_SEAS_405_NAME"
msgstr "Tiêu Cốc Thiên Cơ"
msgid "MAP_REGION_ISLAND_SEAS_405_DESC"
msgstr "Thung lũng đầy cơ quan, nơi hang đá ngầm, cầu đá và cửa ngầm biến cả hòn đảo thành một mê cung."
msgid "MAP_REGION_ISLAND_SEAS_410_NAME"
msgstr "Hồi Âm Cốc Nam Tiêu"
msgid "MAP_REGION_ISLAND_SEAS_410_DESC"
msgstr "Thung lũng giữa quần sơn đá ngầm phương nam, nơi gió biển lùa qua hốc đá và kéo thành tiếng đàn dài bất tận."
msgid "MAP_REGION_ISLAND_SEAS_411_NAME"
msgstr "Mê Tung Thiên Đông Hải"
msgid "MAP_REGION_ISLAND_SEAS_411_DESC"
msgstr "Sơn môn trùng điệp trên nham đảo Đông Hải, nơi sương biển khiến người ta thường lẫn lộn sơn lộ với hải trình."
msgid "MAP_REGION_ISLAND_SEAS_413_NAME"
msgstr "Thánh Hiền Châu Đông Lâm"
msgid "MAP_REGION_ISLAND_SEAS_413_DESC"
msgstr "Học cung ven biển giữa rừng đông, nơi tiếng giảng kinh và ngâm tụng hòa cùng âm vang thủy triều."

msgid "MAP_REGION_MOUNTAIN_FRONTIER_104_NAME"
msgstr "Tuyết Lĩnh Bắc Cảnh"
msgid "MAP_REGION_MOUNTAIN_FRONTIER_104_DESC"
msgstr "Đường tuyết cao trải dọc sống núi, gió cắt da biến cả đất bằng thành những sườn dốc khắc nghiệt."
msgid "MAP_REGION_MOUNTAIN_FRONTIER_107_NAME"
msgstr "Quần Phong Đoạn Lĩnh"
msgid "MAP_REGION_MOUNTAIN_FRONTIER_107_DESC"
msgstr "Sống lưng hiểm trở nhất của dãy núi, nơi muôn đỉnh chen chúc, chia cắt thành tầng tầng đoạn lĩnh."
msgid "MAP_REGION_MOUNTAIN_FRONTIER_108_NAME"
msgstr "Cao Phong Hàn Ngọc"
msgid "MAP_REGION_MOUNTAIN_FRONTIER_108_DESC"
msgstr "Những đỉnh cao quanh năm tuyết phủ, tầm nhìn khoáng đạt nhưng cũng là nơi khó vượt qua bậc nhất miền biên cương."
msgid "MAP_REGION_MOUNTAIN_FRONTIER_110_NAME"
msgstr "Lâm Cốc Giáp Đạo"
msgid "MAP_REGION_MOUNTAIN_FRONTIER_110_DESC"
msgstr "Rừng núi và khe sâu chạy song song, tạo thành một lối đi quanh co, kín đáo xuyên qua quần sơn."
msgid "MAP_REGION_MOUNTAIN_FRONTIER_111_NAME"
msgstr "Tiền Đình Hỏa Sơn"
msgid "MAP_REGION_MOUNTAIN_FRONTIER_111_DESC"
msgstr "Miền chuyển tiếp quanh núi lửa, nơi đá nóng và gió lạnh trực diện giao tranh."
msgid "MAP_REGION_MOUNTAIN_FRONTIER_114_NAME"
msgstr "Phúc Địa Vạn Sơn"
msgid "MAP_REGION_MOUNTAIN_FRONTIER_114_DESC"
msgstr "Vùng lõi chật chội của dãy núi, dày đặc đường hẹp, vách dựng và những đỉnh cao chồng lấn."
msgid "MAP_REGION_MOUNTAIN_FRONTIER_101_NAME"
msgstr "Bình Bá Sơn Khẩu"
msgid "MAP_REGION_MOUNTAIN_FRONTIER_101_DESC"
msgstr "Khoảng đất bằng hiếm hoi giữa quần sơn, nơi thung lũng sông mở rộng và các xóm làng biên cảnh quần tụ."
msgid "MAP_REGION_MOUNTAIN_FRONTIER_102_NAME"
msgstr "Đai Hoàng Thổ Tây Lộc"
msgid "MAP_REGION_MOUNTAIN_FRONTIER_102_DESC"
msgstr "Đất hoàng thổ khô cằn và sườn đá vụn dưới chân núi phía tây, bị cát từ cửa ải thổi mòn nhưng vẫn cách xa đại mạc trống trải."
msgid "MAP_REGION_MOUNTAIN_FRONTIER_103_NAME"
msgstr "Mật Lâm Nam Lĩnh"
msgid "MAP_REGION_MOUNTAIN_FRONTIER_103_DESC"
msgstr "Khu rừng nóng ẩm rậm rạp dưới chân núi phía nam, mưa và sương quấn quanh sườn dốc không tan."
msgid "MAP_REGION_MOUNTAIN_FRONTIER_105_NAME"
msgstr "Hiệp Hải Đông Cảnh"
msgid "MAP_REGION_MOUNTAIN_FRONTIER_105_DESC"
msgstr "Dải biển hẹp ép sát vách núi phía đông, bờ biển bị quần sơn chia thành những vũng cảng nhỏ rời rạc."
msgid "MAP_REGION_MOUNTAIN_FRONTIER_106_NAME"
msgstr "Bôn Lưu Hiệp Hà"
msgid "MAP_REGION_MOUNTAIN_FRONTIER_106_DESC"
msgstr "Dòng sông xiết xẻ xuyên quần sơn, tiếng nước dội giữa vách vực bên những con đường men theo thung lũng."
msgid "MAP_REGION_MOUNTAIN_FRONTIER_112_NAME"
msgstr "Lương Điền Cốc Địa"
msgid "MAP_REGION_MOUNTAIN_FRONTIER_112_DESC"
msgstr "Ruộng đồng được sông tưới dưỡng nép giữa quần sơn, diện tích không lớn nhưng quý giá như kho lương của miền biên cảnh."
msgid "MAP_REGION_MOUNTAIN_FRONTIER_113_NAME"
msgstr "Độc Trạch Nam Lộc"
msgid "MAP_REGION_MOUNTAIN_FRONTIER_113_DESC"
msgstr "Vùng đất ngập nước sâu trong chân núi phía nam, nơi nước lạnh từ núi và đất mục hòa thành những đầm lầy hiểm độc."
msgid "MAP_REGION_MOUNTAIN_FRONTIER_115_NAME"
msgstr "Sơn Ao Tử Trúc"
msgid "MAP_REGION_MOUNTAIN_FRONTIER_115_DESC"
msgstr "Thung trũng kín nơi trúc tím bám theo vách đá, gió lướt qua mang theo âm thanh trong trẻo mà lạnh lẽo."
msgid "MAP_REGION_MOUNTAIN_FRONTIER_116_NAME"
msgstr "Đông Bắc Đống Nguyên"
msgid "MAP_REGION_MOUNTAIN_FRONTIER_116_DESC"
msgstr "Cao nguyên đóng băng ở đông bắc dãy núi, nơi gió rét vượt qua đường tuyết rồi lưu lại suốt nhiều tháng."
msgid "MAP_REGION_MOUNTAIN_FRONTIER_117_NAME"
msgstr "Toái Tinh Pha"
msgid "MAP_REGION_MOUNTAIN_FRONTIER_117_DESC"
msgstr "Sườn đá vụn ngoài Tây Lĩnh, gần như không thể vượt qua bởi đá phong hóa và những truyền thuyết về tinh thiết rơi từ trời."
msgid "MAP_REGION_MOUNTAIN_FRONTIER_118_NAME"
msgstr "Di Đảo Đông Hải"
msgid "MAP_REGION_MOUNTAIN_FRONTIER_118_DESC"
msgstr "Hòn đảo cô độc ngoài dải biển hẹp phía đông, tựa mảnh vỡ tách ra từ nơi non cao gặp biển cả."
msgid "MAP_REGION_MOUNTAIN_FRONTIER_201_NAME"
msgstr "Kim Phủ Tây Lĩnh"
msgid "MAP_REGION_MOUNTAIN_FRONTIER_201_DESC"
msgstr "Động phủ hệ kim nằm sâu trong những đỉnh gãy phía tây, nơi tiếng kiếm ngân vọng qua lại giữa vách đá."
msgid "MAP_REGION_MOUNTAIN_FRONTIER_203_NAME"
msgstr "Huyền Thủy Cảnh Hiệp Hà"
msgid "MAP_REGION_MOUNTAIN_FRONTIER_203_DESC"
msgstr "Bí cảnh hệ thủy tại một khúc quanh của dòng sông hẻm vực, nơi ghềnh xiết xẻ đôi vách núi và hàn linh khí tụ trong đầm sâu."
msgid "MAP_REGION_MOUNTAIN_FRONTIER_302_NAME"
msgstr "Dịch Thành Tây Lĩnh"
msgid "MAP_REGION_MOUNTAIN_FRONTIER_302_DESC"
msgstr "Dịch thành biên cảnh tại cửa ải phía tây, tiếp tế cho thợ mỏ, thợ săn và tu sĩ lên đường đến những miền xa."
msgid "MAP_REGION_MOUNTAIN_FRONTIER_304_NAME"
msgstr "Hiệp Hà Thành"
msgid "MAP_REGION_MOUNTAIN_FRONTIER_304_DESC"
