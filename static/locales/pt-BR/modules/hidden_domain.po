# Hidden Domain
msgid "hidden_domain_story_prompt"
msgstr ""
"Descreva a exploração do domínio oculto. Concentre-se nas experiências "
"individuais ou nas interações entre várias pessoas, como encontros, "
"cooperação, competição ou até ataques. Aborde os perigos enfrentados, as "
"oportunidades encontradas ou a decepção de voltar de mãos vazias, criando "
"uma atmosfera misteriosa, tensa ou imprevisível."

msgid "perished"
msgstr "pereceu"

msgid "{names} returned from {domain} empty-handed."
msgstr "{names} retornaram de {domain} de mãos vazias."

msgid "{name} found a treasure {loot} in {domain}!"
msgstr "{name} encontrou o tesouro {loot} em {domain}!"

msgid "{name} perished in the hidden domain {domain}."
msgstr "{name} pereceu no domínio oculto {domain}."

