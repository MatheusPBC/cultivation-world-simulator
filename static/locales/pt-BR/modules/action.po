msgid "{avatar} disturbed {grave}, but the relic inside had already decayed."
msgstr "{avatar} perturbou {grave}, mas a relíquia em seu interior já havia se deteriorado."

msgid "{avatar} failed to dig up useful relics from {grave}."
msgstr "{avatar} não conseguiu desenterrar relíquias úteis de {grave}."

msgid "{avatar} triggered lingering grave restrictions at {grave} and was injured for {damage} HP."
msgstr "{avatar} ativou restrições remanescentes em {grave} e sofreu {damage} PV de dano."

