msgid ""
msgstr ""
"Language: pt-BR\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "The dynasty responded to {region}'s condition with {decision}: {reason}"
msgstr "A dinastia respondeu à condição de {region} com {decision}: {reason}"

msgid "{sect_name} considered a response to a regional condition."
msgstr "{sect_name} considerou uma resposta a uma condição regional."

msgid "{sect_name} supported {avatar_name} with {amount} spirit stones."
msgstr "{sect_name} apoiou {avatar_name} com {amount} pedras espirituais."

msgid "Sect member support was blocked: {reason}"
msgstr "O apoio ao membro da seita foi bloqueado: {reason}"

msgid "Urban maintenance improved {capability} in {region}."
msgstr "A manutenção urbana melhorou {capability} em {region}."

msgid "Urban maintenance in {region} was blocked: {reason}"
msgstr "A manutenção urbana em {region} foi bloqueada: {reason}"

msgid "{sect_name} concluded a round of sect decisions"
msgstr "{sect_name} concluiu uma rodada de decisões da seita"

msgid "Urban capacity project in {region}: {outcome}."
msgstr "Projeto de capacidade urbana em {region}: {outcome}."

msgid "{region} interpreted an urban risk as {decision}: {reason}"
msgstr "{region} interpretou um risco urbano como {decision}: {reason}"

msgid "The people of {region} publicly petition their government over {label}."
msgstr "O povo de {region} peticiona publicamente ao seu governo sobre {label}."

msgid "A crowd in {region} broke into {asset}."
msgstr "Uma multidão em {region} arrombou {asset}."

msgid "{avatar} publicly endorses the petition of {region}."
msgstr "{avatar} apoia publicamente a petição de {region}."

msgid "The declared headquarters of {institution} is {region}."
msgstr "A sede declarada de {institution} é {region}."

msgid "The people of {region} stop working for one cycle."
msgstr "O povo de {region} para de trabalhar por um ciclo."

msgid "Work resumes in {region} as the stoppage ends."
msgstr "O trabalho recomeça em {region} com o fim da paralisação."

msgid "{region} produced less {resource} during the work stoppage."
msgstr "{region} produziu menos {resource} durante a paralisação."

msgid "A departed voice cannot speak for anyone"
msgstr "Uma voz que partiu não pode falar por ninguém"

msgid "That public petition does not exist"
msgstr "Essa petição pública não existe"

msgid "That petition is no longer public notice"
msgstr "Essa petição já não é aviso público"

msgid "That petition names no city"
msgstr "Essa petição não nomeia nenhuma cidade"

msgid "Only someone in that city can endorse its petition"
msgstr "Só quem está nessa cidade pode apoiar a petição dela"

msgid "That grievance is no longer active"
msgstr "Essa queixa já não está ativa"

msgid "That petition addresses no standing institution"
msgstr "Essa petição não se dirige a nenhuma instituição vigente"

msgid "You have already endorsed that petition"
msgstr "Você já apoiou essa petição"
