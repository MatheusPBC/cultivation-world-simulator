msgid "The annual legitimacy reading leaves the imperial crisis unresolved."
msgstr "A leitura anual de legitimidade mantém a crise imperial sem resolução."

msgid "{actor} made a domain decision: {decision}."
msgstr "{actor} tomou uma decisão de domínio: {decision}."

msgid "The annual legitimacy reading remains unresolved while the throne lacks its recorded emperor."
msgstr "A leitura anual de legitimidade permanece inconclusiva enquanto o trono não possui um imperador registrado."

msgid "The imperial claim fails because the claimant is no longer alive."
msgstr "A pretensão imperial fracassa porque o pretendente não está mais vivo."

msgid "The imperial claimant loses eligibility and the imperial claim fails."
msgstr "O pretendente imperial perde a elegibilidade e sua pretensão fracassa."

msgid "{avatar} committed to an action chain"
msgstr "{avatar} comprometeu-se com uma cadeia de ações"

msgid "{name} was injured in the hidden domain {domain} for {damage} HP."
msgstr "{name} sofreu um ferimento no domínio oculto {domain}, perdendo {damage} de HP."

msgid "{official} publicly opposes the imperial claimant."
msgstr "{official} declarou publicamente oposição ao pretendente imperial."

msgid "{region} population changed from {before} to {after}"
msgstr "A população de {region} mudou de {before} para {after}"

msgid "Unhealed injuries prevent high-risk actions."
msgstr "Ferimentos ainda não curados impedem ações de alto risco."

msgid "The {formation} formation in {region} expired."
msgstr "A formação {formation} em {region} expirou."

msgid "The grave of {name} weathered away."
msgstr "O túmulo de {name} se desfez com o tempo."
