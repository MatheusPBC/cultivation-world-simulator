msgid "minor_event_cause_1"
msgstr "Mudança no estado de espírito"

msgid "minor_event_cause_2"
msgstr "Obsessão inexplicável"

msgid "minor_event_cause_3"
msgstr "Contato cotidiano com equipamentos de cultivo, armas ou técnicas"

msgid "minor_event_cause_4"
msgstr "Reflexão sobre o ambiente atual"

msgid "minor_event_cause_5"
msgstr "Assuntos da seita"

msgid "minor_event_cause_6"
msgstr "Cotidiano do cultivo"

msgid "minor_event_cause_7"
msgstr "Um interlúdio divertido"

msgid "minor_event_cause_8"
msgstr "Pequeno atrito social (avaliar, manter-se em guarda ou zombar um do outro)"

msgid "minor_event_cause_9"
msgstr "Interação assimétrica (ouvir fofocas ou descobrir que falam de alguém pelas costas)"

msgid "minor_event_cause_10"
msgstr "Reflexos cotidianos da rede social (transmissão de voz do companheiro do Dao, teste do mestre ou olhar hostil de um inimigo mortal)"

msgid "minor_event_cause_11"
msgstr "Conversa cotidiana"

msgid "minor_event_cause_12"
msgstr "Afeição secreta crescente"

msgid "minor_event_desc_inner_mood_shift"
msgstr "Uma oscilação interior quando a concentração se dispersa durante o cultivo"

msgid "minor_event_desc_inner_obsession"
msgstr "Um súbito fio de obsessão que surge no coração"

msgid "minor_event_desc_daily_practice"
msgstr "Um momento comum de treino envolvendo técnicas, artefatos ou armas"

msgid "minor_event_desc_environment_response"
msgstr "Uma emoção passageira despertada pelas montanhas, pelos rios e pelo clima diante dos olhos"

msgid "minor_event_desc_sect_errand"
msgstr "Uma tarefa corriqueira da vida na seita"

msgid "minor_event_desc_comic_incident"
msgstr "Um pequeno incidente constrangedor, mas inofensivo"

msgid "minor_event_desc_passing_interaction"
msgstr "Uma breve interação frente a frente durante um encontro casual"

msgid "minor_event_desc_asymmetric_attention"
msgstr "Um momento em que alguém percebe o outro sem necessariamente dizer nada"

msgid "minor_event_desc_subtle_goodwill"
msgstr "Um encontro contido, marcado por um leve sinal de boa vontade"

msgid "minor_event_desc_social_friction"
msgstr "Um pequeno atrito no tom, no olhar ou na atitude"

msgid "minor_event_desc_resource_competition"
msgstr "Uma breve disputa por recursos modestos ou pequenas oportunidades"

msgid "minor_event_desc_small_mutual_help"
msgstr "Um pequeno gesto de ajuda mútua oferecido com naturalidade"
