msgid "OPPORTUNITY_BOON_LUCK_TITLE"
msgstr "Favor Celestial"

msgid "OPPORTUNITY_BOON_LUCK_DESC"
msgstr "Um fio dos mistérios celestiais refina o destino, aumentando ligeiramente a sorte."

msgid "OPPORTUNITY_BOON_LIFESPAN_TITLE"
msgstr "Compreensão da Longevidade"

