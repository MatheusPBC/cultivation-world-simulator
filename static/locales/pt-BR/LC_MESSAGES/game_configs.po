#. normal_region.csv: NORMAL_REGION_102_NAME
msgid "NORMAL_REGION_102_NAME"
msgstr "Areias Movediças do Oeste"

#. normal_region.csv: NORMAL_REGION_103_DESC
msgid "NORMAL_REGION_103_DESC"
