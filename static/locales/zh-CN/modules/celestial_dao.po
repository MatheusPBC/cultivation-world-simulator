msgid ""
msgstr ""
"Project-Id-Version: cultivation-world-simulator 1.0\\n"
"Language: zh_CN\\n"
"Content-Type: text/plain; charset=UTF-8\\n"

msgid "a call to restore rightful order"
msgstr "这是重建正统秩序的召唤"

msgid "a warning against excess and imbalance"
msgstr "这是对过度与失衡的警示"

msgid "a charge to protect those bearing the cost"
msgstr "这是护佑承受代价之人的责任"

msgid "a reminder that worldly claims are temporary"
msgstr "这是对世俗名分终将消散的提醒"

msgid "{sign}: {reading}"
msgstr "{sign}：{reading}"

msgid "A public omen"
msgstr "一道公开的天道征兆"

msgid "Only a sect patriarch or the imperial court may seek a Celestial Audience"
msgstr "只有宗门掌门或朝廷可以求见天道。"

msgid "A Celestial Audience is already awaiting an answer"
msgstr "已有一场天道觐见正在等待回应。"

msgid "An institution seeks a rare Celestial Audience."
msgstr "一个势力正在求得罕见的天道觐见。"

msgid "{institution} holds a public rite and claims the Dao witnesses its cause: {cause}"
msgstr "{institution}举行公开仪式，并宣称天道见证其主张：{cause}"

msgid "A mortal rite claims the Dao favors its cause; this is not a Dao response."
msgstr "凡俗仪式声称天道偏向其主张；这并非天道回应。"

msgid "After sustained {tradition} rites, {institution} seeks a rare audience concerning: {cause}"
msgstr "在持续举行{tradition}仪式后，{institution}就此事求得罕见觐见：{cause}"

msgid "{institution}'s accumulated rites reach a rare Celestial Audience."
msgstr "{institution}积累的仪式终于抵达一次罕见天道觐见。"

msgid "The Dao remains silent."
msgstr "天道仍保持沉默。"

msgid "The Dao has answered"
msgstr "天道已作答"

msgid "{answer} A limited opportunity is granted to the institution."
msgstr "{answer}该势力因此获得一次有限的机缘。"

msgid "{claimant} openly claims the imperial mandate."
msgstr "{claimant}公开宣称帝统。"

msgid "The imperial pretension is withdrawn."
msgstr "这场帝统觊觎被撤回了。"

msgid "{claimant} ascends after a legitimacy crisis."
msgstr "{claimant}在正统危机后登基。"

msgid "{claimant}'s imperial claim fails publicly."
msgstr "{claimant}的帝统觊觎公开失势。"

msgid "The legitimacy crisis remains unresolved."
msgstr "这场正统危机仍未解决。"

msgid "Celestial Audience is not pending"
msgstr "这场天道觐见当前不可回应。"

msgid "response must be silence, sign, or favor"
msgstr "回应只能是沉默、降下征兆或赐予机缘。"
