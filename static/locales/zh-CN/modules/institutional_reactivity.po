msgid ""
msgstr ""
"Language: zh-CN\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "The dynasty responded to {region}'s condition with {decision}: {reason}"
msgstr "王朝针对{region}的状况作出{decision}决定：{reason}"

msgid "{sect_name} considered a response to a regional condition."
msgstr "{sect_name}考虑了如何回应当地状况。"

msgid "{sect_name} supported {avatar_name} with {amount} spirit stones."
msgstr "{sect_name}拨出{amount}灵石援助{avatar_name}。"

msgid "Sect member support was blocked: {reason}"
msgstr "宗门成员援助未能执行：{reason}"

msgid "Urban maintenance improved {capability} in {region}."
msgstr "{region}的{capability}设施经过维护后有所改善。"

msgid "Urban maintenance in {region} was blocked: {reason}"
msgstr "{region}的城市维护未能执行：{reason}"

msgid "{sect_name} concluded a round of sect decisions"
msgstr "{sect_name}完成了一轮宗门决策"

msgid "Urban capacity project in {region}: {outcome}."
msgstr "{region}的城市扩建工程：{outcome}。"

msgid "The people of {region} publicly petition their government over {label}."
msgstr "{region}的百姓就{label}公开向官府请命。"

msgid "A crowd in {region} broke into {asset}."
msgstr "{region}的民众冲入并破坏了{asset}。"

msgid "{avatar} publicly endorses the petition of {region}."
msgstr "{avatar}公开声援{region}的请命。"

msgid "The declared headquarters of {institution} is {region}."
msgstr "{institution}的既定山门位于{region}。"

msgid "The people of {region} stop working for one cycle."
msgstr "{region}的百姓停工一个周期。"

msgid "Work resumes in {region} as the stoppage ends."
msgstr "停工结束，{region}复工。"

msgid "{region} produced less {resource} during the work stoppage."
msgstr "停工期间，{region}的{resource}产量减少。"

msgid "A departed voice cannot speak for anyone"
msgstr "逝者之声无法为任何人发言"

msgid "That public petition does not exist"
msgstr "该公开请命并不存在"

msgid "That petition is no longer public notice"
msgstr "该请命已不再是公开告示"

msgid "That petition names no city"
msgstr "该请命未指明任何城池"

msgid "Only someone in that city can endorse its petition"
msgstr "只有身处该城者才能声援其请命"

msgid "That grievance is no longer active"
msgstr "该怨情已不再持续"

msgid "That petition addresses no standing institution"
msgstr "该请命并未指向现存的机构"

msgid "You have already endorsed that petition"
msgstr "你已声援过该请命"
