  "world_info": {
    "entries": {
      "WORLD_INFO_ACTION_DESC": "Você possui uma série de ações disponíveis. Observe os efeitos, requisitos, regiões e o tempo necessário para cada ação.",
      "WORLD_INFO_ACTION_NAME": "Ações",
      "WORLD_INFO_ACTION_TITLE": "Ações",
      "WORLD_INFO_AUCTION_DESC": "De tempos em tempos, uma figura misteriosa organiza um leilão, onde podem surgir itens valiosos.",
      "WORLD_INFO_AUCTION_NAME": "Leilão",
      "WORLD_INFO_AUCTION_TITLE": "Leilão",
      "WORLD_INFO_BATTLE_DESC": "Neste mundo, prevalece o mais forte. A diferença de reino tem enorme peso, e cultivadores de reinos elevados levam grande vantagem sobre os mais fracos. Se um oponente morrer, o vencedor poderá tomar seus pertences.",
      "WORLD_INFO_BATTLE_NAME": "Combate",
      "WORLD_INFO_BATTLE_TITLE": "Combate",
      "WORLD_INFO_CULTIVATION_DESC": "Cultivar acumula poder até o limite do estágio atual. Uma tentativa de avanço pode ter sucesso ou falhar: o sucesso leva o personagem ao próximo estágio, enquanto a falha pode cobrar um preço.",
      "WORLD_INFO_CULTIVATION_NAME": "Cultivação",
      "WORLD_INFO_CULTIVATION_TITLE": "Cultivação",
      "WORLD_INFO_DEATH_DESC": "Um personagem também morre quando seus PV caem abaixo de zero.",
      "WORLD_INFO_DEATH_NAME": "Morte",
      "WORLD_INFO_DEATH_TITLE": "Morte",
      "WORLD_INFO_EQUIPMENT_AND_ELIXIR_DESC": "Armas, equipamentos auxiliares e elixires concedem bônus adicionais. Equipamentos de alto nível e elixires adequados podem aumentar muito a sobrevivência e a capacidade de combate de um cultivador.",
      "WORLD_INFO_EQUIPMENT_AND_ELIXIR_NAME": "Equipamentos e Elixires",
      "WORLD_INFO_EQUIPMENT_AND_ELIXIR_TITLE": "Equipamentos e Elixires",
      "WORLD_INFO_INTRO_DESC": "Este é um mundo de cultivação onde inúmeros cultivadores disputam poder, recursos e oportunidades em meio a conflitos constantes.",
      "WORLD_INFO_INTRO_NAME": "Introdução",
      "WORLD_INFO_INTRO_TITLE": "Introdução",
      "WORLD_INFO_LIFESPAN_DESC": "Todo personagem possui um limite de vida. Quando ele se esgota, a morte chega. Avançar de reino geralmente prolonga a vida, enquanto falhar em um avanço pode encurtá-la.",
      "WORLD_INFO_LIFESPAN_NAME": "Longevidade",
      "WORLD_INFO_LIFESPAN_TITLE": "Longevidade",
      "WORLD_INFO_ORTHODOXY_DESC": "Cada tradição possui seu próprio método de cultivo. Daoístas absorvem e refinam Qi, artistas marciais temperam o corpo, budistas meditam e confucionistas instruem o povo.",
      "WORLD_INFO_ORTHODOXY_NAME": "Tradição",
      "WORLD_INFO_ORTHODOXY_TITLE": "Tradição",
      "WORLD_INFO_REALM_DESC": "Os reinos básicos do mundo, do mais fraco ao mais forte, são Refinamento de Qi, Estabelecimento da Fundação, Formação do Núcleo e Alma Nascente. Cada reino possui os estágios Inicial, Intermediário e Avançado. Tradições diferentes podem usar outros nomes, mas as regras seguem essa mesma progressão.",
      "WORLD_INFO_REALM_NAME": "Reino",
      "WORLD_INFO_REALM_TITLE": "Reino",
      "WORLD_INFO_REGION_DESC": "Cada região oferece condições e efeitos diferentes. Realizar a ação certa no lugar adequado torna o esforço muito mais eficiente.",
      "WORLD_INFO_REGION_NAME": "Região",
      "WORLD_INFO_REGION_TITLE": "Região",
      "WORLD_INFO_ROOT_DESC": "As raízes espirituais são formadas pelos cinco elementos — Metal, Madeira, Água, Fogo e Terra — e podem ser Únicas, Duplas ou Celestiais. Na relação entre os elementos: Metal supera Madeira, Madeira supera Terra, Terra supera Água, Água supera Fogo e Fogo supera Metal. A Raiz Espiritual Celestial reúne os cinco elementos e concede um bônus adicional ao avançar. O cultivo é mais eficiente em regiões compatíveis com o elemento da raiz espiritual do personagem.",
      "WORLD_INFO_ROOT_NAME": "Raiz Espiritual",
      "WORLD_INFO_ROOT_TITLE": "Raiz Espiritual",
      "WORLD_INFO_SECRET_REALM_DESC": "Reinos Secretos se abrem a cada poucos anos. Explorá-los envolve perigos, mas também pode render artefatos e técnicas de alto nível.",
      "WORLD_INFO_SECRET_REALM_NAME": "Reino Secreto",
      "WORLD_INFO_SECRET_REALM_TITLE": "Reino Secreto",
      "WORLD_INFO_SECT_DESC": "As seitas oferecem abrigo aos cultivadores. Ao entrar em uma, é possível aprender técnicas exclusivas e receber a proteção dos demais discípulos. Cultivadores independentes têm mais liberdade, mas contam com menos recursos.",
      "WORLD_INFO_SECT_NAME": "Seita",
      "WORLD_INFO_SECT_TITLE": "Seita",
      "WORLD_INFO_SHOPPING_DESC": "Nas cidades, é possível comprar elixires e armas do nível de Refinamento de Qi. Elixires comprados são consumidos imediatamente para fortalecer o personagem, enquanto armas permitem trocar para um tipo mais adequado ao seu estilo.",
      "WORLD_INFO_SHOPPING_NAME": "Comércio",
      "WORLD_INFO_SHOPPING_TITLE": "Comércio",
      "WORLD_INFO_SPIRIT_STONE_DESC": "A moeda corrente do mundo da cultivação. Pedras espirituais servem para comprar artefatos e elixires e podem ser obtidas por coleta, comércio ou saque.",
      "WORLD_INFO_SPIRIT_STONE_NAME": "Pedra Espiritual",
      "WORLD_INFO_SPIRIT_STONE_TITLE": "Pedra Espiritual",
      "WORLD_INFO_WORLD_QI_DESC": "A cada poucos anos, o mundo passa por mudanças celestiais, como Marés de Qi, que afetam as habilidades dos personagens.",
      "WORLD_INFO_WORLD_QI_NAME": "Qi Mundial",
      "WORLD_INFO_WORLD_QI_TITLE": "Qi Mundial",
      "WORLD_INFO_RANKING_DESC": "O mundo da cultivação possui os Rankings do Céu, da Terra e dos Homens, além do Ranking de Seitas. Os três rankings individuais são separados pelo reino padrão equivalente: o Céu reúne especialistas de Alma Nascente, a Terra reúne cultivadores de Formação do Núcleo e os Homens reúnem cultivadores de Estabelecimento da Fundação. O Ranking de Seitas as classifica pelo poder total.",
      "WORLD_INFO_RANKING_NAME": "Rankings",
      "WORLD_INFO_RANKING_TITLE": "Rankings",
      "WORLD_INFO_DYNASTY_DESC": "Dinastias mortais governam os territórios, preservando a ordem e as fronteiras do mundo secular. Imperadores não vivem mais do que mortais comuns; quando um morre, um sucessor assume o trono.",
      "WORLD_INFO_DYNASTY_NAME": "Dinastia",
      "WORLD_INFO_DYNASTY_TITLE": "Dinastia",
      "WORLD_INFO_OFFICIAL_DESC": "Cultivadores podem servir à corte imperial, acumulando reputação e recebendo salário. Com reputação suficiente, podem ser promovidos; quanto mais alto o cargo, maiores o salário e a sorte concedida. Se negligenciarem suas funções por muito tempo, sua reputação diminuirá gradualmente.",
      "WORLD_INFO_OFFICIAL_NAME": "Cargo Imperial",
      "WORLD_INFO_OFFICIAL_TITLE": "Cargo Imperial",
      "WORLD_INFO_CULTIVATION_ALIAS_DESC": "Os mesmos níveis de cultivação recebem nomes diferentes em cada tradição. Daoístas e cultivadores independentes usam Refinamento de Qi, Estabelecimento da Fundação, Formação do Núcleo e Alma Nascente; artistas marciais usam Temperamento Corporal, Fortalecimento dos Tendões, Mestre Marcial e Santo Marcial; confucionistas usam Cultivo do Qi Vital, Iluminação dos Princípios, Estabelecimento do Mandato e Grande Erudito; budistas usam Noviço, Monge, Arhat e Bodisatva; cultivadores yao usam Despertar Espiritual, Transformação da Forma, Núcleo Demoníaco e Rei Demônio. Esses nomes representam a mesma sequência básica de reinos: alteram a narrativa e os termos da interface, mas não as regras de avanço, poder, longevidade, nível de itens ou outros sistemas.",
      "WORLD_INFO_CULTIVATION_ALIAS_NAME": "Nomes dos Reinos",
      "WORLD_INFO_CULTIVATION_ALIAS_TITLE": "Nomes dos Reinos"
    }
  },
